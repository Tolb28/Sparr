# Sparr Frontend Environment Variables
# Copy to .env and fill in values

# Backend API URL (used for all API requests)
# Local dev (Android emulator): http://10.0.2.2:4000/api
# Local dev (physical device): http://<your-machine-ip>:4000/api
# Production: https://your-api-domain.com/api
EXPO_PUBLIC_API_URL=http://localhost:4000/api
